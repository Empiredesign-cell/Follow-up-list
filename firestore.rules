rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email
        : '';
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function myProfile() {
      return get(profilePath()).data;
    }

    function accountActive() {
      return hasProfile() &&
        (!('active' in myProfile()) || myProfile().active != false) &&
        (!('deleted' in myProfile()) || myProfile().deleted != true);
    }

    function isSuperAdmin() {
      return accountActive() &&
        authEmail() == 'empiredesign1510@gmail.com' &&
        myProfile().role == 'super_admin';
    }

    function isLegacyOwner() {
      return accountActive() &&
        authEmail() == 'ciptadigi@gmail.com' &&
        (myProfile().role == 'legacy_owner' ||
         (('ownsLegacyData' in myProfile()) && myProfile().ownsLegacyData == true));
    }

    function isDivisionAdmin() {
      return accountActive() &&
        myProfile().role == 'division_admin' &&
        ('divisionId' in myProfile()) &&
        myProfile().divisionId is string &&
        myProfile().divisionId != '';
    }

    function myDivisionId() {
      return hasProfile() && ('divisionId' in myProfile()) && myProfile().divisionId is string
        ? myProfile().divisionId
        : '';
    }

    function sameDivision(divisionId) {
      return accountActive() &&
        divisionId is string &&
        divisionId != '' &&
        divisionId == myDivisionId();
    }

    function isCiptaDigiDivision(divisionId) {
      return divisionId is string &&
        divisionId != '' &&
        exists(/databases/$(database)/documents/divisions/$(divisionId)) &&
        ('ciptaDigiAccess' in get(/databases/$(database)/documents/divisions/$(divisionId)).data) &&
        get(/databases/$(database)/documents/divisions/$(divisionId)).data.ciptaDigiAccess == true;
    }

    function hasWeekendFeature() {
      let divisionId = myDivisionId();
      return accountActive() &&
        divisionId != '' &&
        exists(/databases/$(database)/documents/divisions/$(divisionId)) &&
        ('features' in get(/databases/$(database)/documents/divisions/$(divisionId)).data) &&
        ('titipanWeekend' in get(/databases/$(database)/documents/divisions/$(divisionId)).data.features) &&
        get(/databases/$(database)/documents/divisions/$(divisionId)).data.features.titipanWeekend == true;
    }

    function folderAccessible(folderId) {
      return isSuperAdmin() ||
        (
          isLegacyOwner() &&
          exists(/databases/$(database)/documents/folders/$(folderId)) &&
          ('divisionId' in get(/databases/$(database)/documents/folders/$(folderId)).data) &&
          (
            get(/databases/$(database)/documents/folders/$(folderId)).data.divisionId == '' ||
            isCiptaDigiDivision(get(/databases/$(database)/documents/folders/$(folderId)).data.divisionId)
          )
        ) ||
        (
          accountActive() &&
          exists(/databases/$(database)/documents/folders/$(folderId)) &&
          ('divisionId' in get(/databases/$(database)/documents/folders/$(folderId)).data) &&
          get(/databases/$(database)/documents/folders/$(folderId)).data.divisionId == myDivisionId()
        );
    }

    // =========================================================
    // USER PROFILE
    // =========================================================
    match /users/{uid} {
      allow get: if signedIn() && (
        request.auth.uid == uid ||
        isSuperAdmin() ||
        (isDivisionAdmin() && resource.data.divisionId == myDivisionId())
      );

      // Legacy owner tidak boleh melihat daftar user.
      allow list: if isSuperAdmin() ||
        (isDivisionAdmin() && resource.data.divisionId == myDivisionId());

      allow create: if signedIn() && (
        // Bootstrap Super Admin tunggal.
        (
          request.auth.uid == uid &&
          authEmail() == 'empiredesign1510@gmail.com' &&
          request.resource.data.email == 'empiredesign1510@gmail.com' &&
          request.resource.data.role == 'super_admin'
        ) ||
        // Bootstrap akun legacy.
        (
          request.auth.uid == uid &&
          authEmail() == 'ciptadigi@gmail.com' &&
          request.resource.data.email == 'ciptadigi@gmail.com' &&
          request.resource.data.role == 'legacy_owner' &&
          request.resource.data.ownsLegacyData == true
        ) ||
        // Pengguna boleh membuat profil MEMBER miliknya sendiri, tetapi statusnya pending dan belum aktif.
        (
          request.auth.uid == uid &&
          request.resource.data.email == authEmail() &&
          request.resource.data.role == 'member' &&
          request.resource.data.active == false &&
          request.resource.data.pendingApproval == true &&
          request.resource.data.divisionId == '' &&
          (!('ownsLegacyData' in request.resource.data) || request.resource.data.ownsLegacyData != true)
        ) ||
        // Super Admin membuat Admin Divisi / Member saja.
        (
          isSuperAdmin() &&
          request.resource.data.email != 'empiredesign1510@gmail.com' &&
          request.resource.data.email != 'ciptadigi@gmail.com' &&
          (request.resource.data.role == 'division_admin' || request.resource.data.role == 'member')
        ) ||
        // Admin Divisi hanya membuat member di grup sendiri.
        (
          isDivisionAdmin() &&
          request.resource.data.divisionId == myDivisionId() &&
          request.resource.data.role == 'member' &&
          (!('ownsLegacyData' in request.resource.data) || request.resource.data.ownsLegacyData != true)
        )
      );

      allow update: if signedIn() && (
        // Dua akun sistem boleh menormalkan profilnya sendiri.
        (
          request.auth.uid == uid &&
          authEmail() == 'empiredesign1510@gmail.com' &&
          request.resource.data.email == 'empiredesign1510@gmail.com' &&
          request.resource.data.role == 'super_admin'
        ) ||
        (
          request.auth.uid == uid &&
          authEmail() == 'ciptadigi@gmail.com' &&
          request.resource.data.email == 'ciptadigi@gmail.com' &&
          request.resource.data.role == 'legacy_owner' &&
          request.resource.data.ownsLegacyData == true
        ) ||
        // Super Admin boleh mengatur user, tetapi role sistem tetap terkunci.
        (
          isSuperAdmin() &&
          (
            (
              resource.data.email == 'empiredesign1510@gmail.com' &&
              request.resource.data.email == 'empiredesign1510@gmail.com' &&
              request.resource.data.role == 'super_admin'
            ) ||
            (
              resource.data.email == 'ciptadigi@gmail.com' &&
              request.resource.data.email == 'ciptadigi@gmail.com' &&
              request.resource.data.role == 'legacy_owner' &&
              request.resource.data.ownsLegacyData == true
            ) ||
            (
              resource.data.email != 'empiredesign1510@gmail.com' &&
              resource.data.email != 'ciptadigi@gmail.com' &&
              request.resource.data.email == resource.data.email &&
              (request.resource.data.role == 'division_admin' || request.resource.data.role == 'member')
            )
          )
        ) ||
        // Admin Divisi hanya boleh mengubah MEMBER di divisinya.
        (
          isDivisionAdmin() &&
          resource.data.divisionId == myDivisionId() &&
          resource.data.role == 'member' &&
          request.resource.data.divisionId == myDivisionId() &&
          request.resource.data.role == 'member' &&
          request.resource.data.email == resource.data.email &&
          (!('ownsLegacyData' in request.resource.data) || request.resource.data.ownsLegacyData != true)
        )
      );

      allow delete: if isSuperAdmin() &&
        resource.data.email != 'empiredesign1510@gmail.com' &&
        resource.data.email != 'ciptadigi@gmail.com';

      match /appState/{document=**} {
        allow read, write: if signedIn() && (
          request.auth.uid == uid || isSuperAdmin()
        );
      }
    }

    // =========================================================
    // DIVISI / GROUP
    // =========================================================
    match /divisions/{divisionId} {
      allow get: if isSuperAdmin() || sameDivision(divisionId) || (isLegacyOwner() && resource.data.ciptaDigiAccess == true);
      allow list: if isSuperAdmin() || (isLegacyOwner() && resource.data.ciptaDigiAccess == true);
      allow create, update, delete: if isSuperAdmin();
    }

    // =========================================================
    // WORKSPACE / ROOM
    // =========================================================
    match /folders/{folderId} {
      // PRIVASI V32: satu room tetap hanya dimiliki satu divisi.
      // Cipta Digital membaca room legacy + room dari divisi yang dicentang Cipta Digi oleh Super Admin.
      allow read: if isSuperAdmin() ||
        (
          isLegacyOwner() &&
          ('divisionId' in resource.data) &&
          (resource.data.divisionId == '' || isCiptaDigiDivision(resource.data.divisionId))
        ) ||
        (accountActive() && ('divisionId' in resource.data) && resource.data.divisionId == myDivisionId());

      // ciptadigi tidak boleh membuat room baru.
      allow create: if isSuperAdmin() ||
        (isDivisionAdmin() && request.resource.data.divisionId == myDivisionId());

      // ciptadigi juga tidak mengubah struktur room; hanya isi workspace_data.
      allow update: if isSuperAdmin() ||
        (
          isDivisionAdmin() &&
          resource.data.divisionId == myDivisionId() &&
          request.resource.data.divisionId == myDivisionId()
        );

      allow delete: if isSuperAdmin() ||
        (isDivisionAdmin() && resource.data.divisionId == myDivisionId());
    }

    // Task/sticky/archive lama tetap memakai document ID workspace yang sama.
    match /workspace_data/{workspaceId} {
      allow read, write: if folderAccessible(workspaceId);
    }

    // Riwayat perubahan room khusus Super Admin.
    match /room_history/{roomId}/versions/{versionId} {
      allow read, delete: if isSuperAdmin();
      allow create: if isSuperAdmin() || (isDivisionAdmin() && folderAccessible(roomId));
      allow update: if false;
    }

    // Titipan Weekend default milik Cipta Digital, tetapi Super Admin dapat
    // mengaktifkannya untuk divisi tertentu dari Feature Flags.
    match /shared_data/{document=**} {
      allow read, write: if isLegacyOwner() || isSuperAdmin() || hasWeekendFeature();
    }

    match /global_workspace/{document=**} {
      allow read, write: if isSuperAdmin() || isLegacyOwner();
    }

    // =========================================================
    // SELF-SERVICE ACCESS REQUEST
    // =========================================================
    match /access_requests/{requestId} {
      allow create: if signedIn() && request.auth.uid == requestId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == authEmail() &&
        request.resource.data.type == 'member_access' &&
        request.resource.data.status == 'pending';
      allow get: if signedIn() && (request.auth.uid == requestId || isSuperAdmin());
      allow list, update, delete: if isSuperAdmin();
    }

    // =========================================================
    // FEEDBACK DEVELOPER
    // =========================================================
    match /feedback/{feedbackId} {
      allow create: if accountActive() &&
        request.resource.data.accountUid == request.auth.uid;
      allow get: if accountActive() && (resource.data.accountUid == request.auth.uid || isSuperAdmin());
      allow list, update, delete: if isSuperAdmin();
    }

    // =========================================================
    // CUSTOM ICON / CHARACTER PNG
    // =========================================================
    match /custom_icons/{iconId} {
      allow read: if accountActive();
      allow create, update, delete: if isSuperAdmin();
    }



    // =========================================================
    // V41.2 REALTIME ROOM LEADERBOARD
    // =========================================================
    match /leaderboard_rooms/{roomId} {
      allow read: if accountActive();

      allow create: if accountActive() &&
        folderAccessible(roomId) &&
        request.resource.data.roomId == roomId &&
        request.resource.data.liveTaskAdds == 1 &&
        exists(/databases/$(database)/documents/folders/$(roomId)) &&
        request.resource.data.divisionId == get(/databases/$(database)/documents/folders/$(roomId)).data.divisionId;

      allow update: if accountActive() &&
        folderAccessible(roomId) &&
        request.resource.data.roomId == roomId &&
        request.resource.data.liveTaskAdds == resource.data.liveTaskAdds + 1 &&
        exists(/databases/$(database)/documents/folders/$(roomId)) &&
        request.resource.data.divisionId == get(/databases/$(database)/documents/folders/$(roomId)).data.divisionId;

      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // V41 USAGE LEADERBOARD
    // Semua akun aktif dapat membaca klasemen global.
    // Member/Admin Divisi hanya boleh menambah statistik miliknya sendiri.
    // Delta per flush dibatasi maksimal 3 menit agar tidak bisa mengubah skor
    // besar dalam satu request dari client.
    // =========================================================
    match /usage_stats/{uid} {
      allow read: if accountActive();

      // Super Admin boleh melakukan one-time historical bootstrap / koreksi metadata klasemen.
      allow create, update: if isSuperAdmin();

      allow create: if accountActive() &&
        request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.divisionId == myDivisionId() &&
        (myProfile().role == 'member' || myProfile().role == 'division_admin') &&
        request.resource.data.role == myProfile().role &&
        request.resource.data.totalActiveMinutes is number &&
        request.resource.data.totalActiveMinutes >= 0 &&
        request.resource.data.totalActiveMinutes <= 3 &&
        request.resource.data.weeklyMinutes is number &&
        request.resource.data.weeklyMinutes >= 0 &&
        request.resource.data.weeklyMinutes <= 3 &&
        request.resource.data.monthlyMinutes is number &&
        request.resource.data.monthlyMinutes >= 0 &&
        request.resource.data.monthlyMinutes <= 3;

      allow update: if accountActive() &&
        request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.divisionId == myDivisionId() &&
        (myProfile().role == 'member' || myProfile().role == 'division_admin') &&
        request.resource.data.role == myProfile().role &&
        request.resource.data.totalActiveMinutes >= resource.data.totalActiveMinutes &&
        request.resource.data.totalActiveMinutes <= resource.data.totalActiveMinutes + 3 &&
        (
          (
            request.resource.data.weekKey == resource.data.weekKey &&
            request.resource.data.weeklyMinutes >= resource.data.weeklyMinutes &&
            request.resource.data.weeklyMinutes <= resource.data.weeklyMinutes + 3
          ) ||
          (
            request.resource.data.weekKey != resource.data.weekKey &&
            request.resource.data.weeklyMinutes >= 0 &&
            request.resource.data.weeklyMinutes <= 3
          )
        ) &&
        (
          (
            request.resource.data.monthKey == resource.data.monthKey &&
            request.resource.data.monthlyMinutes >= resource.data.monthlyMinutes &&
            request.resource.data.monthlyMinutes <= resource.data.monthlyMinutes + 3
          ) ||
          (
            request.resource.data.monthKey != resource.data.monthKey &&
            request.resource.data.monthlyMinutes >= 0 &&
            request.resource.data.monthlyMinutes <= 3
          )
        );

      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // V40 AUDIT LOGS - user aktif boleh menulis, hanya Super Admin membaca global.
    // =========================================================
    match /audit_logs/{logId} {
      allow create: if accountActive() && request.resource.data.actorUid == request.auth.uid;
      allow read, update, delete: if isSuperAdmin();
    }

    // =========================================================
    // V40 RESTORE CENTER
    // Snapshot delete boleh dibuat user aktif. Restore Center hanya Super Admin.
    // =========================================================
    match /restore_bin/{restoreId} {
      allow create: if accountActive() && request.resource.data.deletedBy == request.auth.uid;
      allow read, update, delete: if isSuperAdmin();
    }

    // =========================================================
    // V40 DEVICE SESSIONS
    // Device menulis/monitor sesi sendiri; Super Admin melihat & revoke semua.
    // =========================================================
    match /device_sessions/{sessionId} {
      allow create: if accountActive() && request.resource.data.uid == request.auth.uid;
      allow get: if isSuperAdmin() || (accountActive() && resource.data.uid == request.auth.uid);
      allow list: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        accountActive() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid
      );
      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // V40 BROADCAST ANNOUNCEMENTS
    // Pengumuman bersifat internal non-rahasia: akun aktif membaca, Super Admin mengelola.
    // =========================================================
    match /announcements/{announcementId} {
      allow read: if isSuperAdmin() || isLegacyOwner() || (
        accountActive() && (
          resource.data.targetType == 'all' ||
          (('divisionId' in resource.data) && resource.data.divisionId == myDivisionId())
        )
      );
      allow create, update, delete: if isSuperAdmin();
    }

    match /attendance_reminders/{uid} {
      allow read, create, update, delete: if signedIn() && (
        request.auth.uid == uid || isSuperAdmin()
      );
    }
  }
}
