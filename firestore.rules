rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function myProfile() {
      return get(profilePath()).data;
    }

    function isSuperAdmin() {
      return hasProfile() && myProfile().active != false && myProfile().role == 'super_admin';
    }

    function hasWorkspace(workspaceId) {
      return isSuperAdmin() || (
        hasProfile() &&
        myProfile().active != false &&
        workspaceId in myProfile().workspaceIds
      );
    }

    function canUseLegacyShared() {
      return isSuperAdmin() || (
        hasProfile() &&
        myProfile().active != false &&
        myProfile().allowSharedLegacy == true
      );
    }

    // Profil akun.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());

      // Bootstrap satu kali akun owner lama.
      allow create: if signedIn() && (
        isSuperAdmin() ||
        (
          request.auth.uid == uid &&
          request.auth.token.email == 'ciptadigi@gmail.com' &&
          request.resource.data.role == 'super_admin'
        )
      );

      // Pengelolaan role/akses hanya Super Admin.
      allow update, delete: if isSuperAdmin();

      // Data tampilan pribadi per akun, mis. background beranda.
      match /appState/{document=**} {
        allow read, write: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      }
    }

    // Metadata workspace lama tetap di tempat semula.
    match /folders/{folderId} {
      allow read: if hasWorkspace(folderId);
      allow create, update, delete: if isSuperAdmin();
    }

    // Seluruh task/sticky/archive legacy tetap memakai document ID workspace yang sama.
    match /workspace_data/{workspaceId} {
      allow read, write: if hasWorkspace(workspaceId);
    }

    // Data bersama lama hanya untuk owner/super admin atau akun yang diberi izin eksplisit.
    match /shared_data/{document=**} {
      allow read, write: if canUseLegacyShared();
    }

    match /global_workspace/{document=**} {
      allow read, write: if canUseLegacyShared();
    }

    // Jika masih ada collection reminder cloud lama, batasi per akun.
    match /attendance_reminders/{uid} {
      allow read, create, update, delete: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
    }
  }
}
