rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email
        : '';
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function myProfile() {
      return get(profilePath()).data;
    }

    function accountActive() {
      return hasProfile() &&
        (!('active' in myProfile()) || myProfile().active != false) &&
        (!('deleted' in myProfile()) || myProfile().deleted != true);
    }

    function isSuperAdmin() {
      return accountActive() &&
        authEmail() == 'empiredesign1510@gmail.com' &&
        myProfile().role == 'super_admin';
    }

    function isLegacyOwner() {
      return accountActive() &&
        authEmail() == 'ciptadigi@gmail.com' &&
        (myProfile().role == 'legacy_owner' ||
         (('ownsLegacyData' in myProfile()) && myProfile().ownsLegacyData == true));
    }

    function isDivisionAdmin() {
      return accountActive() &&
        myProfile().role == 'division_admin' &&
        ('divisionId' in myProfile()) &&
        myProfile().divisionId is string &&
        myProfile().divisionId != '';
    }

    function myDivisionId() {
      return hasProfile() && ('divisionId' in myProfile()) && myProfile().divisionId is string
        ? myProfile().divisionId
        : '';
    }

    function sameDivision(divisionId) {
      return accountActive() &&
        divisionId is string &&
        divisionId != '' &&
        divisionId == myDivisionId();
    }

    function folderAccessible(folderId) {
      return isSuperAdmin() ||
        isLegacyOwner() ||
        (
          accountActive() &&
          exists(/databases/$(database)/documents/folders/$(folderId)) &&
          get(/databases/$(database)/documents/folders/$(folderId)).data.divisionId == myDivisionId()
        );
    }

    // =========================================================
    // USER PROFILE
    // =========================================================
    match /users/{uid} {
      allow get: if signedIn() && (
        request.auth.uid == uid ||
        isSuperAdmin() ||
        (isDivisionAdmin() && resource.data.divisionId == myDivisionId())
      );

      // Legacy owner tidak boleh melihat daftar user.
      allow list: if isSuperAdmin() ||
        (isDivisionAdmin() && resource.data.divisionId == myDivisionId());

      allow create: if signedIn() && (
        // Bootstrap Super Admin tunggal.
        (
          request.auth.uid == uid &&
          authEmail() == 'empiredesign1510@gmail.com' &&
          request.resource.data.email == 'empiredesign1510@gmail.com' &&
          request.resource.data.role == 'super_admin'
        ) ||
        // Bootstrap akun legacy.
        (
          request.auth.uid == uid &&
          authEmail() == 'ciptadigi@gmail.com' &&
          request.resource.data.email == 'ciptadigi@gmail.com' &&
          request.resource.data.role == 'legacy_owner' &&
          request.resource.data.ownsLegacyData == true
        ) ||
        // Pengguna boleh membuat profil MEMBER miliknya sendiri, tetapi statusnya pending dan belum aktif.
        (
          request.auth.uid == uid &&
          request.resource.data.email == authEmail() &&
          request.resource.data.role == 'member' &&
          request.resource.data.active == false &&
          request.resource.data.pendingApproval == true &&
          request.resource.data.divisionId == '' &&
          (!('ownsLegacyData' in request.resource.data) || request.resource.data.ownsLegacyData != true)
        ) ||
        // Super Admin membuat Admin Divisi / Member saja.
        (
          isSuperAdmin() &&
          request.resource.data.email != 'empiredesign1510@gmail.com' &&
          request.resource.data.email != 'ciptadigi@gmail.com' &&
          (request.resource.data.role == 'division_admin' || request.resource.data.role == 'member')
        ) ||
        // Admin Divisi hanya membuat member di grup sendiri.
        (
          isDivisionAdmin() &&
          request.resource.data.divisionId == myDivisionId() &&
          request.resource.data.role == 'member' &&
          (!('ownsLegacyData' in request.resource.data) || request.resource.data.ownsLegacyData != true)
        )
      );

      allow update: if signedIn() && (
        // Dua akun sistem boleh menormalkan profilnya sendiri.
        (
          request.auth.uid == uid &&
          authEmail() == 'empiredesign1510@gmail.com' &&
          request.resource.data.email == 'empiredesign1510@gmail.com' &&
          request.resource.data.role == 'super_admin'
        ) ||
        (
          request.auth.uid == uid &&
          authEmail() == 'ciptadigi@gmail.com' &&
          request.resource.data.email == 'ciptadigi@gmail.com' &&
          request.resource.data.role == 'legacy_owner' &&
          request.resource.data.ownsLegacyData == true
        ) ||
        // Super Admin boleh mengatur user, tetapi role sistem tetap terkunci.
        (
          isSuperAdmin() &&
          (
            (
              resource.data.email == 'empiredesign1510@gmail.com' &&
              request.resource.data.email == 'empiredesign1510@gmail.com' &&
              request.resource.data.role == 'super_admin'
            ) ||
            (
              resource.data.email == 'ciptadigi@gmail.com' &&
              request.resource.data.email == 'ciptadigi@gmail.com' &&
              request.resource.data.role == 'legacy_owner' &&
              request.resource.data.ownsLegacyData == true
            ) ||
            (
              resource.data.email != 'empiredesign1510@gmail.com' &&
              resource.data.email != 'ciptadigi@gmail.com' &&
              request.resource.data.email == resource.data.email &&
              (request.resource.data.role == 'division_admin' || request.resource.data.role == 'member')
            )
          )
        ) ||
        // Admin Divisi hanya boleh mengubah MEMBER di divisinya.
        (
          isDivisionAdmin() &&
          resource.data.divisionId == myDivisionId() &&
          resource.data.role == 'member' &&
          request.resource.data.divisionId == myDivisionId() &&
          request.resource.data.role == 'member' &&
          request.resource.data.email == resource.data.email &&
          (!('ownsLegacyData' in request.resource.data) || request.resource.data.ownsLegacyData != true)
        )
      );

      allow delete: if isSuperAdmin() &&
        resource.data.email != 'empiredesign1510@gmail.com' &&
        resource.data.email != 'ciptadigi@gmail.com';

      match /appState/{document=**} {
        allow read, write: if signedIn() && (
          request.auth.uid == uid || isSuperAdmin()
        );
      }
    }

    // =========================================================
    // DIVISI / GROUP
    // =========================================================
    match /divisions/{divisionId} {
      allow get: if isSuperAdmin() || sameDivision(divisionId);
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // =========================================================
    // WORKSPACE / ROOM
    // =========================================================
    match /folders/{folderId} {
      // ciptadigi tetap dapat melihat seluruh data workspace yang sudah ada.
      allow read: if isSuperAdmin() || isLegacyOwner() ||
        (accountActive() && resource.data.divisionId == myDivisionId());

      // ciptadigi tidak boleh membuat room baru.
      allow create: if isSuperAdmin() ||
        (isDivisionAdmin() && request.resource.data.divisionId == myDivisionId());

      // ciptadigi juga tidak mengubah struktur room; hanya isi workspace_data.
      allow update: if isSuperAdmin() ||
        (
          isDivisionAdmin() &&
          resource.data.divisionId == myDivisionId() &&
          request.resource.data.divisionId == myDivisionId()
        );

      allow delete: if isSuperAdmin() ||
        (isDivisionAdmin() && resource.data.divisionId == myDivisionId());
    }

    // Task/sticky/archive lama tetap memakai document ID workspace yang sama.
    match /workspace_data/{workspaceId} {
      allow read, write: if folderAccessible(workspaceId);
    }

    // Titipan Weekend / data bersama lama KHUSUS akun Cipta Digital.
    match /shared_data/{document=**} {
      allow read, write: if isLegacyOwner();
    }

    match /global_workspace/{document=**} {
      allow read, write: if isSuperAdmin() || isLegacyOwner();
    }

    // =========================================================
    // SELF-SERVICE ACCESS REQUEST
    // =========================================================
    match /access_requests/{requestId} {
      allow create: if signedIn() && request.auth.uid == requestId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == authEmail() &&
        request.resource.data.type == 'member_access' &&
        request.resource.data.status == 'pending';
      allow get: if signedIn() && (request.auth.uid == requestId || isSuperAdmin());
      allow list, update, delete: if isSuperAdmin();
    }

    // =========================================================
    // FEEDBACK DEVELOPER
    // =========================================================
    match /feedback/{feedbackId} {
      allow create: if accountActive() &&
        request.resource.data.accountUid == request.auth.uid;
      allow get: if accountActive() && (resource.data.accountUid == request.auth.uid || isSuperAdmin());
      allow list, update, delete: if isSuperAdmin();
    }

    match /attendance_reminders/{uid} {
      allow read, create, update, delete: if signedIn() && (
        request.auth.uid == uid || isSuperAdmin()
      );
    }
  }
}
